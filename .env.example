APP_NAME=Rentflow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Tenant portal (React); invitation emails link here.
PORTAL_URL=http://localhost:5174
# Admin portal (React); team invitations and password resets link here.
ADMIN_URL=http://localhost:5173
# Tenant app store links, shown in invitations (email + WhatsApp). Empty = the portal URL.
TENANT_APP_ANDROID_URL=
TENANT_APP_IOS_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rentflow
DB_USERNAME=rentflow
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Bills are emailed to tenants (InvoiceIssuedMail, PDF attached). Dev: "log" writes them to
# storage/logs/laravel.log. Production: smtp (or ses/postmark/resend) with real credentials, and
# MAIL_FROM_ADDRESS on a domain you control; the landlord's name is used as the sender name.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Origins of the React SPAs that log in with cookies (admin + tenant portal dev servers).
# Not the API's own origin: the docs at /docs call the API with a bearer token, and listing
# localhost:8000 here would put those calls through CSRF checks (419).
# React SPA origins that get cookie sessions. Never add bare `localhost`: the Android app's
# origin is https://localhost and its bearer-token requests would then need CSRF (419).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174
# Other origins allowed to call the API (Capacitor apps; SPAs on another subdomain in production).
CORS_ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost

# Interactive API reference at /docs (always on in local).
# API_DOCS_ENABLED=false

# WhatsApp bills (Meta WhatsApp Cloud API). Each landlord connects their own number via
# PUT /api/admin/whatsapp; these are shared settings. See docs/WHATSAPP.md.
WHATSAPP_API_VERSION=v23.0
# WHATSAPP_BILL_TEMPLATE=rentflow_bill_issued
# WHATSAPP_BILL_TEMPLATE_LANGUAGE=en
# WHATSAPP_INVITATION_TEMPLATE=rentflow_tenant_invitation
# WHATSAPP_RECEIPT_TEMPLATE=rentflow_payment_receipt

# "Continue with Google" (both portals). Google Cloud → OAuth client ID (type "Web application").
# Comma-separate several IDs if needed; the apps use the web client ID too. Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=
