# Rentflow API in production (server 102.212.246.251, /home/tito/rentflow/backend).
# Copy to .env on the server, fill in the blanks, then: php artisan key:generate && php artisan config:cache
# Never commit the real .env. See ../deploy/README.md.

APP_NAME=Rentflow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.rentflow.codepasstech.top

# Where the React apps run: invitation, set-password and bill links point here.
PORTAL_URL=https://rentflow.codepasstech.top
ADMIN_URL=https://admin.rentflow.codepasstech.top

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rentflow
DB_USERNAME=rentflow
DB_PASSWORD=

# Cookie sessions for the two web apps. Each app calls the API on its own host (nginx hands /api/ and
# /sanctum/ to Laravel), so the cookie stays first-party per host: leave SESSION_DOMAIN empty.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# SESSION_DOMAIN=   (leave unset: host-only cookies)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Bill emails, WhatsApp, invitations run on the queue: keep deploy/server/rentflow-queue.service running.
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="bills@codepasstech.top"
MAIL_FROM_NAME="${APP_NAME}"

# The two React apps get cookie sessions (their own hosts; no ports in production).
SANCTUM_STATEFUL_DOMAINS=admin.rentflow.codepasstech.top,rentflow.codepasstech.top
# Origins allowed to call api.rentflow.codepasstech.top directly: the web apps (if they ever do) and
# the Android / iOS apps (Capacitor origins https://localhost and capacitor://localhost, bearer tokens).
CORS_ALLOWED_ORIGINS=https://admin.rentflow.codepasstech.top,https://rentflow.codepasstech.top,https://localhost,capacitor://localhost

# Reverse proxy in front of nginx: empty while Cloudflare is DNS-only (grey cloud); "*" once the records
# are proxied (orange cloud) so Laravel sees https and real visitor IPs.
TRUSTED_PROXIES=

# Interactive API reference at /docs: off in production unless you need it.
API_DOCS_ENABLED=false

WHATSAPP_API_VERSION=v23.0

# "Continue with Google": the web OAuth client ID (Authorized JavaScript origins:
# https://admin.rentflow.codepasstech.top and https://rentflow.codepasstech.top). Empty = off.
GOOGLE_CLIENT_IDS=
